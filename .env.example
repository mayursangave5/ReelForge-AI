# Copy to .env and fill in. Never commit .env.

# --- Content / language ---
LANGUAGE=hi
TTS_PROVIDER=edge
TTS_RATE=+4%
VOICE=hi-IN-MadhurNeural
TIMEZONE=Asia/Kolkata
SCHEDULE_TIMES=09:00,17:00

# --- Safety switches ---
APPROVAL_MODE=true
AUTO_PUBLISH=false

# --- Video ---
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
MIN_DURATION_S=30
MAX_DURATION_S=60

# --- LLM (free tier only, dual-key failover & automatic model fallback) ---
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# --- Trends (optional, enables YouTube search source) ---
YOUTUBE_API_KEY=

# --- YouTube upload (OAuth desktop client JSON) ---
# Place the downloaded file in data/tokens/client_secret.json or set this path.
YOUTUBE_CLIENT_SECRETS=
YOUTUBE_PRIVACY=private

# --- Instagram Graph API (Reels publishing) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v21.0

# --- Google Cloud (TTS is not used; edge-tts is free) ---
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Image provider (optional) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2 (required for automatic Instagram publishing) ---
# Account ID defaults to CLOUDFLARE_ACCOUNT_ID when left empty.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket URL, e.g. https://pub-xxxx.r2.dev or https://cdn.yourdomain.com
R2_PUBLIC_BASE_URL=
R2_PREFIX=reels
# Hours to keep the MP4 after a successful publish (0 = delete immediately)
R2_RETENTION_HOURS=24

# --- Video provider (optional) ---
FAL_KEY=

# --- Voice provider (optional) ---
ELEVENLABS_API_KEY=

# --- Tools ---
# Leave empty to auto-detect .tools/ffmpeg/bin or PATH
FFMPEG_PATH=
